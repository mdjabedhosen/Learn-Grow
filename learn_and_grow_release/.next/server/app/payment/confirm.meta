{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/payment/layout,_N_T_/payment/confirm/layout,_N_T_/payment/confirm/page,_N_T_/payment/confirm/"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/payment/confirm/__PAGE__",
    "/payment/confirm",
    "/payment",
    "/_index",
    "/_head"
  ]
}