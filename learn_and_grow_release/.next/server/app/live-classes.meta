{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/live-classes/layout,_N_T_/live-classes/page,_N_T_/live-classes/"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/live-classes/__PAGE__",
    "/live-classes",
    "/_index",
    "/_head"
  ]
}