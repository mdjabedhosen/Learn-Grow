# ==========================================
# LEARN & GROW - Backend Environment Variables
# ==========================================
# TEMPLATE ONLY - copy to `.env` and fill in real values.
# `.env` is git-ignored; NEVER commit real secrets.
#
#   cp .env.example .env
#
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
# For Docker Compose (service name `mongodb`)
MONGODB_URI=mongodb://admin:admin123@127.0.0.1:27017/learn_grow_db?authSource=admin
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me
# For local host-run MongoDB (uncomment if running without Docker)
# MONGODB_URI=mongodb://admin:admin123@localhost:27017/learn_grow_db?authSource=admin

# Mongo Express (Database UI)
ME_CONFIG_MONGODB_ADMINUSERNAME=admin
ME_CONFIG_MONGODB_ADMINPASSWORD=change-me
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=change-me

# ==========================================
# JWT Configuration (REQUIRED)
# ==========================================
# The server REFUSES TO START if these are missing, too short (<32 chars)
# or equal to a known placeholder. They are what sign access tokens, so a
# committed default would let anyone forge a token for any account.
#
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
JWT_SECRET=replace-with-a-48-byte-random-hex-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-a-different-48-byte-random-hex-string
JWT_REFRESH_EXPIRES_IN=30d

# ==========================================
# EMAIL CONFIGURATION (REQUIRED for email notifications)
# ==========================================
# For Gmail:
# 1. Enable 2-Factor Authentication
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an app password for "Mail"
# 4. Use that password below (remove spaces)

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-app-password

# ==========================================
# SMTP seeding (Optional)
# ==========================================
# Used by the boot-time SMTP seeder when no active SMTP config exists yet.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_APP_PASSWORD=your-16-character-app-password

# ==========================================
# SMS Configuration (Optional - Twilio)
# ==========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==========================================
# GOOGLE OAUTH (Optional - Server runs without these)
# ==========================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Every callback URI this server may present to Google, comma separated.
# Each one MUST be listed under the OAuth client's "Authorized redirect URIs",
# otherwise Google answers with `redirect_uri_mismatch`.
# Verify with: npm run google:oauth:check
GOOGLE_CALLBACK_URL=https://learnandgrow.io/api/auth/google/callback
GOOGLE_CALLBACK_URLS=http://localhost:5005/api/auth/google/callback,https://learnandgrow.io/api/auth/google/callback

# Frontend URL
FRONTEND_URL=https://learnandgrow.io
# Every frontend this server may redirect the browser to, comma separated.
FRONTEND_URLS=http://localhost:3000,https://learnandgrow.io

# Backend URL
BACKEND_URL=https://learnandgrow.io

# ==========================================
# SETUP NOTES:
# ==========================================
# 1. ✅ Server runs WITHOUT Google OAuth (shows warning only)
# 2. 📧 Email features require valid SMTP settings above
# 3. 🔑 For Gmail App Password:
#    - Must have 2FA enabled first
#    - Use 16-character app password
#    - Remove spaces when entering
# 4. 🚫 Never commit the .env file to Git!
# 5. 📝 Copy this file to .env and fill in your values
# 6. 👤 To create an administrator account, run: npm run create-admin
