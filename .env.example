# ==========================================
# LEARN & GROW - Docker Compose Environment
# ==========================================
# TEMPLATE ONLY - copy to `.env` and fill in real values.
# `.env` is git-ignored; NEVER commit real secrets.


# Application Mode
NODE_ENV=production

# Port Configuration
MONGODB_PORT=27017
BACKEND_PORT=5000
FRONTEND_PORT=3000
MONGO_EXPRESS_PORT=8081

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me

# Mongo Express (Database UI)
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=change-me

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=replace-with-a-48-byte-random-hex-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-a-different-48-byte-random-hex-string
JWT_REFRESH_EXPIRES_IN=30d

# Email Configuration (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=learngroweducation@gmail.com
EMAIL_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://learnandgrow.io/api/auth/google/callback

# Frontend Configuration
FRONTEND_URL=https://learnandgrow.io
NEXT_PUBLIC_API_URL=https://learnandgrow.io/api
