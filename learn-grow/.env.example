# ==========================================
# LEARN & GROW - Frontend Environment Variables
# ==========================================
# TEMPLATE ONLY - copy to `.env` and fill in real values.
# `.env` is git-ignored; NEVER commit real secrets.
#
#   cp .env.example .env
#
# ==========================================

# API base URL (server-side, used by route handlers / SSR)
NEXT_PUBLIC_API_URL=http://localhost:5005/api

# ==========================================
# Meta Pixel & Direct Conversions API (Optional)
# ==========================================
# The pixel id is public by design. The CAPI access token is NOT - it is a
# credential for the Conversions API and must never be committed.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
