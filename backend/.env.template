# 🎯 READY-TO-USE ENVIRONMENT TEMPLATE

# Copy this file to .env and fill in your credentials
# Get credentials from the services (see FREE_STACK_SETUP.md)

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=production
PORT=5000

# ===========================================
# MONGODB ATLAS (Database)
# ===========================================
# Get from: https://cloud.mongodb.com/
# 1. Create cluster
# 2. Database Access → Create user
# 3. Network Access → Add IP (0.0.0.0/0)
# 4. Connect → Drivers → Copy connection string

DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/learn-and-grow?retryWrites=true&w=majority

# EXAMPLE (replace with yours):
# DATABASE_URL=mongodb+srv://admin:MyPass123@cluster0.abc12.mongodb.net/learn-and-grow?retryWrites=true&w=majority

# ===========================================
# JWT SECRETS (Authentication)
# ===========================================
# Generate random strings (keep these secret!)
JWT_ACCESS_SECRET=change_this_to_random_string_min_32_chars
JWT_REFRESH_SECRET=change_this_to_another_random_string
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=365d

# ===========================================
# PASSWORD HASHING
# ===========================================
BCRYPT_SALT_ROUND=12

# ===========================================
# SUPER ADMIN (First Admin Account)
# ===========================================
SUPPER_ADMIN_PASSWORD=YourStrongPassword@123

# ===========================================
# CLOUDINARY (Image Storage)
# ===========================================
# Get from: https://console.cloudinary.com/
# Dashboard → Account Details

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# EXAMPLE (replace with yours):
# CLOUDINARY_CLOUD_NAME=dxyz123
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz

# ===========================================
# OPTIONAL: Email (for password reset)
# ===========================================
ADMIN_EMAIL=your-email@gmail.com

# ===========================================
# OPTIONAL: SMS (for phone verification)
# ===========================================
SMS_ACCOUNT_SID=your_twilio_sid
SMS_AUTH_TOKEN=your_twilio_token

# ===========================================
# NOTES FOR YOUTUBE
# ===========================================
# YouTube doesn't need API keys for unlisted videos!
# Just upload videos to YouTube, set visibility to "Unlisted"
# Copy the video URL and store it in MongoDB
# Example: https://youtu.be/abc123xyz
# No configuration needed here!
